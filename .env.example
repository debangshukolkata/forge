# Copy to .env and fill in. Never commit .env.

# Azure OpenAI (all roles by default; see config llm.roles)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=<api version>
AZURE_OPENAI_DEPLOYMENT=<deployment name>
# Second model used by some roles (see config llm.models)
AZURE_OPENAI_SECONDARY_DEPLOYMENT=<deployment name>
AZURE_OPENAI_API_KEY=<key>

# Gemini on Vertex AI (only if a role uses a gemini model). Auth is Application Default Credentials
# (gcloud auth application-default login) - no key goes in this file. Both lines below are optional:
# the project is taken from the credentials, the region defaults to us-central1.
# GOOGLE_CLOUD_PROJECT=<gcp project id>
# GOOGLE_CLOUD_LOCATION=<region>

# Local Postgres used for DB-backed tests (preferred target)
LOCAL_PG_URL=postgresql://postgres:<password>@localhost:5432/forge_dev
# Same database, used by Forge's own test suite
FORGE_PG_URL=postgresql://postgres:<password>@localhost:5432/forge_dev

# Shared remote dev DB — read-only for Forge
DEV_PG_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Optional
TAVILY_API_KEY=<key>
# Optional alternative web search (Google via SerpAPI); without either key Forge uses DuckDuckGo.
SERPAPI_API_KEY=<key>
GEMINI_API_KEY=<key>
