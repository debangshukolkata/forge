# Copy to .env and fill in. Never commit .env.

# Azure OpenAI (all roles by default; see config llm.roles)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=<api version>
AZURE_OPENAI_DEPLOYMENT=<deployment name>
# Optional fallback model on a second Azure OpenAI resource (separate quota); without these Forge has no fallback
# AZURE_FALLBACK_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_FALLBACK_API_VERSION=<api version>
# AZURE_FALLBACK_API_KEY=<key>
# AZURE_FALLBACK_DEPLOYMENT=<deployment name>
# Second model used by some roles (see config llm.models)
AZURE_OPENAI_SECONDARY_DEPLOYMENT=<deployment name>
AZURE_OPENAI_API_KEY=<key>

# Gemini on Vertex AI (only if a role uses a gemini model). Auth is Application Default Credentials
# (gcloud auth application-default login) - no key goes in this file. Both lines below are optional:
# the project is taken from the credentials, the region defaults to us-central1.
# GOOGLE_CLOUD_PROJECT=<gcp project id>
# GOOGLE_CLOUD_LOCATION=<region>      # Gemini 3 models (and the Gemini 3 image models) are served only from `global`; the 2.5 family answers from `global` too, so `global` suits every model
# Image generation (the generate_image tool) uses Gemini or Imagen on Vertex AI with the same credentials. Optional model name:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image      # or gemini-3.1-flash-image (14 s) / gemini-3-pro-image (22 s, best); both need GOOGLE_CLOUD_LOCATION=global

# Local Postgres used for DB-backed tests (preferred target)
LOCAL_PG_URL=postgresql://postgres:<password>@localhost:5432/forge_dev
# Same database, used by Forge's own test suite
FORGE_PG_URL=postgresql://postgres:<password>@localhost:5432/forge_dev

# Shared remote dev DB — read-only for Forge
DEV_PG_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Optional
# Optional alternative web search (Google via SerpAPI); without either key Forge uses DuckDuckGo.
SERPAPI_API_KEY=<key>
# Optional: the company's Tavily search tool on the agent platform (answer the Tavily question in the Environment panel)
# TAVILY_TOOL_URL=<the tool's execute-tool address>
# TAVILY_TOOL_ID=<the tool's number, e.g. 2361>
# TAVILY_BEARER_TOKEN=<bearer token; it usually expires>
# The other Tavily tools on the same endpoint (same URL and token); each is offered only when its number is set:
# TAVILY_RESEARCH_TOOL_ID=<Tavily Research number, e.g. 2362>
# TAVILY_EXTRACT_TOOL_ID=<Tavily Extract number, e.g. 2408>
# TAVILY_CRAWL_TOOL_ID=<Tavily Crawl number, e.g. 2411>
# Only the dev helper scripts/dev/model_options.py reads a Gemini API key; DebCraft itself uses the Vertex AI credentials above.
# GEMINI_API_KEY=<key>
# Optional: free keys for the stock-photo search of find_image / fetch_image (each source is skipped without its key).
# PEXELS_API_KEY=<key>
# UNSPLASH_ACCESS_KEY=<key>
# PIXABAY_API_KEY=<key>
# Optional: your own SearXNG search engine (web search tries it first when this is set).
# SEARXNG_URL=http://localhost:8080

# Optional: full path to tesseract.exe, if it is installed somewhere Forge does not look (not on PATH).
# TESSERACT_CMD=C:\Users\<you>\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
# Optional stronger model (D-359): the deployment name of gpt-5.4 or gpt-5.2 on the SECOND Azure resource (AZURE_FALLBACK_*). Roles can then name it in config.yaml:
#   llm: { roles: { coder: gpt54, vision: gpt54, judge: gpt54 } }
# AZURE_STRONG_DEPLOYMENT=<deployment name>      # gpt-5.4, for example aicloud-gpt-5.4
# AZURE_GPT52_DEPLOYMENT=<deployment name>       # gpt-5.2, for example aicloud-gpt-5.2: the Azure critic, judge and reviewer when Gemini is not enabled (D-413)

# Optional: a free OKSLOP key (okslop.com/developers) raises the limits of the sample-picture search; the search works without it.
# OKSLOP_API_KEY=
