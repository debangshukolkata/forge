        [
          "Mar",
          "=B3*(1+GrowthPerMonth)",
          "=C3*(1+CostGrowth)",
          "=B4-C4",
          "=MAX(D4,0)*TaxRate"
        ]
      ],
      "total_row": {
        "A": "Total",
        "B": "SUM",
        "C": "SUM",
        "D": "SUM",
        "E": "SUM"
      },
      "charts": [
        {
          "type": "column",
          "title": "Revenue and costs",
          "data": "B1:C4",
          "categories": "A2:A4",
          "anchor": "G2"
        }
      ]
    }
