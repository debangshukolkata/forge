from fastapi.testclient import TestClient

from {{package}}.app import create_app


def client() -> TestClient:
    return TestClient(create_app())


def test_health() -> None:
    assert client().get("/health").json() == {"status": "ok"}


def test_create_and_read_an_item() -> None:
    api = client()
    created = api.post("/items", json={"name": "bolt", "quantity": 3})
    assert created.status_code == 201 and created.json() == {"id": 1, "name": "bolt", "quantity": 3}
    assert api.get("/items/1").json()["name"] == "bolt"
    assert len(api.get("/items").json()) == 1


def test_unknown_item_is_404_and_bad_input_is_422() -> None:
    api = client()
    assert api.get("/items/99").status_code == 404
    assert api.post("/items", json={"name": "", "quantity": -1}).status_code == 422
